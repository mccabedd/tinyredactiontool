<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TinyRedactionTool</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
    <!-- 3.0.0 (David): the name Windows shows for the program (Open With, Task Manager, file properties). -->
    <AssemblyTitle>TinyRedactionTool</AssemblyTitle>
    <Product>TinyRedactionTool</Product>
    <Company>David McCabe</Company>
    <Copyright>Copyright (C) 2026 David McCabe</Copyright>
    <Description>Redact and annotate pictures and videos on this computer.</Description>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/TinyRedaction.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/icon.ico" /></ItemGroup>
  <!-- Windows Forms is used only for the standard system colour dialog. Keep WPF names unambiguous. -->
  <ItemGroup><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="TinyRedaction.Checks" /></ItemGroup>
  <ItemGroup><PackageReference Include="LibVLCSharp" Version="[3.10.2]" /></ItemGroup>
  <ItemGroup><Content Include="../native-runtime/**/*" Link="native/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /><EmbeddedResource Include="../dependencies/native-manifest.json" LogicalName="native-manifest.json" /></ItemGroup>
  <!-- 3.0.0 (David): the Help manual travels with TRT (Help › Help). -->
  <ItemGroup><Content Include="../docs/help/**/*" Exclude="../docs/help/images/places.json" Link="help/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Content Include="../tools/*.exe" Link="tools/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
