<Window x:Class="TinyRedaction.Desktop.RecorderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Icon="Assets/icon.ico" Title="Screen Recorder" Width="380" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
 Background="{DynamicResource Surface}" Foreground="{DynamicResource Foreground}" FontFamily="Segoe UI" FontSize="12">
 <!-- Screen Recorder (0.12.0): choose what to record, then Record. -->
 <StackPanel Margin="16,12,16,14">
  <TextBlock Text="What to Record" Style="{StaticResource PanelHeading}" Margin="0,0,0,6"/>
  <RadioButton x:Name="RegionChoice" GroupName="Area" Margin="0,3" Foreground="{DynamicResource Foreground}" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="2,0,8,0"><Path Data="{StaticResource AccentCaptureRegion}" Fill="{StaticResource AccentGlass}"/><Path Data="{StaticResource IconCaptureRegion}" Stroke="{DynamicResource Foreground}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Grid><TextBlock Text="Rectangle: Drag Round the Area" VerticalAlignment="Center"/></StackPanel></RadioButton>
  <RadioButton x:Name="WindowChoice" GroupName="Area" Margin="0,3" Foreground="{DynamicResource Foreground}" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="2,0,8,0"><Path Data="{StaticResource AccentCaptureWindow}" Fill="{StaticResource AccentBlue}"/><Path Data="{StaticResource IconCaptureWindow}" Stroke="{DynamicResource Foreground}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Grid><TextBlock Text="Window: Click the Window to Record" VerticalAlignment="Center"/></StackPanel></RadioButton>
  <RadioButton x:Name="FullScreenChoice" GroupName="Area" Margin="0,3" Foreground="{DynamicResource Foreground}" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="2,0,8,0"><Path Data="{StaticResource AccentCaptureScreen}" Fill="{StaticResource AccentBlue}"/><Path Data="{StaticResource IconCaptureScreen}" Stroke="{DynamicResource Foreground}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Grid><TextBlock Text="Full Screen: The Screen with the Cursor" VerticalAlignment="Center"/></StackPanel></RadioButton>
  <RadioButton x:Name="WorkAreaChoice" GroupName="Area" Margin="0,3" Foreground="{DynamicResource Foreground}" VerticalContentAlignment="Center"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="2,0,8,0"><Path Data="{StaticResource AccentCaptureWorkArea}" Fill="{StaticResource AccentBlue}"/><Path Data="{StaticResource IconCaptureWorkArea}" Stroke="{DynamicResource Foreground}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Grid><TextBlock Text="Full Screen Without the Taskbar" VerticalAlignment="Center"/></StackPanel></RadioButton>
  <StackPanel Orientation="Horizontal" Margin="0,12,0,2">
   <TextBlock Text="Frames per Second" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox x:Name="FrameRateChoice" Width="64"/>
  </StackPanel>
  <CheckBox x:Name="PointerChoice" Content="Record the Mouse Pointer" Margin="0,6,0,0"/>
  <CheckBox x:Name="ClicksChoice" Content="Show Mouse Clicks (Yellow Ring)" Margin="0,4,0,0"/>
  <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" Foreground="{DynamicResource Warning}"
   Text="No sound is recorded. Use the yellow bar to pause, stop or discard; the recording then opens in the editor."/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button x:Name="RecordButton" Content="Record" MinWidth="80" Margin="0,0,8,0" Padding="8,3" IsDefault="True" Click="Record" Background="#D32F2F" Foreground="White" BorderBrush="#9A1F1F" FontWeight="SemiBold"/>
   <Button Content="Cancel" MinWidth="80" Padding="8,3" IsCancel="True"/>
  </StackPanel>
 </StackPanel>
</Window>
