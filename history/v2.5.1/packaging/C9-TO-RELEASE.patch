+        }
+        if((Get-Item -LiteralPath $marker).Attributes -band [IO.FileAttributes]::ReparsePoint){continue}
+        try{$lease=[IO.File]::Open($marker,[IO.FileMode]::Open,[IO.FileAccess]::ReadWrite,[IO.FileShare]::None)}catch{continue}
